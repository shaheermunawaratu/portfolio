{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "format": "prettier --write .",
    "lint": "eslint . && htmlhint index.html && prettier --check .",
    "test": "playwright test",
    "lhci": "lhci autorun",
    "check": "npm run lint && npm run build && npm test",
    "ship": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ship.ps1",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,css,html,json,md,yml,yaml}": "prettier --write"
  }
}
